generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id
  email           String?   @unique
  passwordHash    String?
  name            String
  age             Int
  photo           String
  bio             String
  city            String
  interests       String
  gender          String    @default("UNDISCLOSED")
  interestedIn    String    @default("EVERYONE")
  occupation      String?
  createdAt       DateTime  @default(now())

  sessions        Session[]
  swipesMade      Swipe[]   @relation("Swiper")
  swipesOn        Swipe[]   @relation("Target")
  matchesAsOne    Match[]   @relation("MatchUserOne")
  matchesAsTwo    Match[]   @relation("MatchUserTwo")
  messages        Message[] @relation("MessageSender")
}

model Swipe {
  id           String     @id @default(cuid())
  swiperId     String
  targetUserId String
  action       SwipeAction
  createdAt    DateTime   @default(now())

  swiper User @relation("Swiper", fields: [swiperId], references: [id], onDelete: Cascade)
  target User @relation("Target", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([swiperId, targetUserId])
  @@index([targetUserId])
}

model Match {
  id        String    @id @default(cuid())
  userOneId String
  userTwoId String
  createdAt DateTime  @default(now())
  userOne   User      @relation("MatchUserOne", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwo   User      @relation("MatchUserTwo", fields: [userTwoId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([userOneId, userTwoId])
  @@index([userOneId])
  @@index([userTwoId])
}

model Message {
  id        String   @id @default(cuid())
  matchId   String
  senderId  String
  text      String
  createdAt DateTime @default(now())

  match  Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender User  @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum SwipeAction {
  LIKE
  PASS
}
